    children:
      - url: "{{ _.envParabank }}/createAccount"
        name: Abrir conta
        meta:
          id: req_23cea7c04b254bad826e80c2dd130803
          created: 1775041007199
          modified: 1779834522755
          isPrivate: false
          description: ""
          sortKey: -1777294457845
        method: POST
        parameters:
          - name: customerId
            value: "12212"
            description: ""
            disabled: false
          - name: newAccountType
            value: "1"
            description: ""
            disabled: false
          - name: fromAccountId
            value: "13344"
            description: ""
            disabled: false
        headers:
          - name: User-Agent
            value: insomnia/12.4.0
            description: ""
            disabled: false
          - name: Accept
            value: application/json
            description: ""
            disabled: false
        scripts:
          afterResponse: >-
            const body = JSON.parse(insomnia.response.body);


            insomnia.environment.set("accountId", body.id);


            // Testes

            insomnia.test("Verificar status code", () => {
            	insomnia.expect(insomnia.response.code).to.equal(200);
            });


            insomnia.test("Verificar retorno de id", () => {
            	insomnia.expect(body).to.have.property("id");
            });


            insomnia.test("Verificar retorno do tipo de conta", () => {
            	// Como enviamos o tipo 0 (Checking), validamos se a API devolveu a string correspondente
            	insomnia.expect(body.type).to.equal("CHECKING");
            });
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
