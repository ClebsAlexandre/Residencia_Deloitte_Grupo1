            insomnia.test("Request retorna 200 para busca sem resultados", () =>
            {
                insomnia.expect(insomnia.response.code).to.equal(200);
            });


            // Teste 2: Valida se o sistema devolve uma lista vazia corretamente

            insomnia.test("Response deve ser um array vazio", () => {
                const body = insomnia.response.json(); 
                
                insomnia.expect(body).to.be.an("array");
                insomnia.expect(body).to.be.empty; 
            });
