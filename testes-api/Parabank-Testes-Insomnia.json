      - url: "{{ _.envParabank }}/accounts/{{ _.baseAccountId }}/transactions"
        name: Listar transações de uma conta
        meta:
          id: req_b6fb4b85952c4c718d8593f6694a9be3
          created: 1777295925540
          modified: 1780065747754
          isPrivate: false
          description: ""
          sortKey: -1777297819187
        method: GET
        headers:
          - name: User-Agent
            value: insomnia/12.5.0
            description: ""
            disabled: false
          - name: Accept
            value: application/json
            description: ""
            disabled: false
        scripts:
          afterResponse: >-
            // 1. Garante que a API respondeu certo

            insomnia.test("O status code deve ser 200", () => {
                insomnia.expect(insomnia.response.code).to.equal(200);
            });


            // 2. Garante que a estrutura da resposta não quebrou (deve ser
            sempre uma lista)

            insomnia.test("A resposta deve ser um array", () => {
                const body = insomnia.response.json();
                insomnia.expect(body).to.be.an('array');
            });


            // 3. Valida os tipos de dados dinamicamente (só se houver
            transações)

            insomnia.test("As transações devem conter a estrutura correta", ()
            => {
                const body = insomnia.response.json();
                
                if (body.length > 0) {
                    const transacao = body[0]; // Pega a primeira transação que vier
                    
                    // Verifica se os campos existem e são do tipo esperado
                    insomnia.expect(transacao).to.have.property('id').that.is.a('number');
                    insomnia.expect(transacao).to.have.property('amount').that.is.a('number');
                    insomnia.expect(transacao).to.have.property('type').that.is.a('string');
                    
                    
                    // Salva o ID da transação no Base Environment
                    insomnia.environment.set("transactionId", transacao.id);
                    
                    // Salva o valor (amount) da transação também, para usar na sua busca por valor!
                    insomnia.environment.set("transactionAmount", transacao.amount);
                }
            });
        settings:
          renderRequestBody: true
          encodeUrl: true
          followRedirects: global
          cookies:
            send: true
            store: true
          rebuildPath: true
